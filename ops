#!/bin/bash
set -euo pipefail

LIBEXEC="$(cd "$(dirname "$0")" && pwd)/libexec"

usage() {
    cat >&2 <<EOF
Usage: ops <command> [args]

  health     system health check
  net        host:port reachability
  ports      listening ports
  ssh        connect by partial hostname
  clean      remove dead containers and images
  gcp        GCE instance control
  gcp-status   list GCE instances
  ipwatch      report local IP, warn on change

  Run 'ops <command> -h' for command-specific options.
EOF
    exit 1
}

cmd="${1:-}"
[[ -z "$cmd" ]] && usage
shift

case "$cmd" in
    health)  exec "$LIBEXEC/health.sh" "$@" ;;
    net)     exec "$LIBEXEC/netcheck.sh" "$@" ;;
    ports)   exec "$LIBEXEC/ports.sh" "$@" ;;
    connect) exec "$LIBEXEC/ssht-app.sh" "$@" ;;
    clean)   exec "$LIBEXEC/dockerclean.sh" "$@" ;;
    gcp)     exec "$LIBEXEC/gcp-start-stop.sh" "$@" ;;
    gcp-status) exec "$LIBEXEC/gcpstatus" "$@" ;;
    ipwatch) exec "$LIBEXEC/ipwatch" "$@" ;;
    help|-h) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage ;;
esac
